ROUTING_DATA_ROOT=/srv/beeline-routing
ROUTING_STATE_DB=/srv/beeline-routing/state/routing.sqlite3
ROUTING_UPLOAD_DIR=/srv/beeline-routing/quarantine
ROUTING_UPDATE_COMMAND="/opt/beeline/.venv/bin/python /opt/beeline/scripts/build_moscow_osrm.py"
ROUTING_GATEWAY_URL=http://127.0.0.1:4180
ROUTING_MATRIX_MODE=gateway
ROUTING_WITH_FOOT=1
OSRM_FOOT_URL=http://osrm-foot:5000
ROUTING_MAX_UPLOAD_BYTES=2000000000
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:26.9.0-debian@sha256:8a1b1bc938412f15f9b5b32d794c4ec6bf4a85dfbbabfa0a014b70b187edb53b
OSMIUM_IMAGE=beeline-osmium:local
OSRM_RUNTIME_MEMORY=4g
