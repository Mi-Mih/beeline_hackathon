FROM docker@sha256:018edbc908e08fcc9dbf029c812c34251e9b4719e6f71ca0e5eae2a987d014ca AS docker-cli

FROM python:3.12-slim

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose

WORKDIR /app
COPY pyproject.toml /app/
COPY backend /app/backend
RUN pip install --no-cache-dir .

COPY frontend /app/frontend
COPY examples /app/examples
COPY scripts /app/scripts
COPY deploy/routing /app/deploy/routing

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "backend"]
