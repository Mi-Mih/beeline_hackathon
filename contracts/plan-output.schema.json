{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/plan-output.schema.json",
  "title": "Technician planning result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "algorithm", "routes", "unassigned", "metrics", "diagnostics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technician_id", "technician_name", "start_location_id", "finish_at", "stops", "metrics"],
        "properties": {
          "technician_id": { "type": "string" },
          "technician_name": { "type": "string" },
          "start_location_id": { "type": "string" },
          "finish_at": { "type": "string", "format": "date-time" },
          "stops": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/stop" }
          },
          "metrics": { "$ref": "#/$defs/routeMetrics" }
        }
      }
    },
    "unassigned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "reason"],
        "properties": {
          "request_id": { "type": "string" },
          "reason": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "details"],
            "properties": {
              "code": {
                "enum": ["NO_SKILLED_TECHNICIAN", "NO_REQUIRED_VEHICLE", "NO_REQUIRED_EQUIPMENT", "LOCKED_TECHNICIAN_UNAVAILABLE", "NO_FEASIBLE_TIME_SLOT", "TRAVEL_DATA_MISSING"]
              },
              "message": { "type": "string" },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": ["required_skills", "required_vehicle", "required_equipment", "locked_technician_id"],
                "properties": {
                  "required_skills": { "type": "array", "items": { "type": "string" } },
                  "required_vehicle": { "type": ["string", "null"] },
                  "required_equipment": { "type": "array", "items": { "type": "string" } },
                  "locked_technician_id": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "metrics": { "$ref": "#/$defs/planMetrics" },
    "travel_time_calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "applied"],
      "properties": {
        "mode": { "enum": ["osrm", "engineer_history"] },
        "applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["technician_id", "factor", "observation_count", "calibration_ready"],
            "properties": {
              "technician_id": { "type": "string" },
              "factor": { "type": "number", "minimum": 0.25, "maximum": 4 },
              "observation_count": { "type": "integer", "minimum": 1 },
              "calibration_ready": { "type": "boolean" }
            }
          }
        }
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graph_version", "engine", "algorithm", "profile_version"],
        "properties": {
          "graph_version": { "type": ["string", "null"] },
          "engine": { "type": ["string", "null"] },
          "algorithm": { "type": ["string", "null"] },
          "profile_version": { "type": ["string", "null"] }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_ms", "warnings"],
      "properties": {
        "runtime_ms": { "type": "number", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "request_id", "location_id", "arrival_at", "service_start_at", "service_end_at", "travel_minutes", "distance_km", "wait_minutes", "explanation"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "request_id": { "type": "string" },
        "location_id": { "type": "string" },
        "arrival_at": { "type": "string", "format": "date-time" },
        "service_start_at": { "type": "string", "format": "date-time" },
        "service_end_at": { "type": "string", "format": "date-time" },
        "travel_minutes": { "type": "integer", "minimum": 0 },
        "distance_km": { "type": "number", "minimum": 0 },
        "wait_minutes": { "type": "integer", "minimum": 0 },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "routeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_count", "distance_km", "travel_minutes", "service_minutes", "wait_minutes"],
      "properties": {
        "request_count": { "type": "integer", "minimum": 1 },
        "distance_km": { "type": "number", "minimum": 0 },
        "travel_minutes": { "type": "integer", "minimum": 0 },
        "service_minutes": { "type": "integer", "minimum": 0 },
        "wait_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "planMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_count", "assigned_count", "unassigned_count", "used_technicians", "distance_km", "travel_minutes", "service_minutes", "wait_minutes"],
      "properties": {
        "request_count": { "type": "integer", "minimum": 0 },
        "assigned_count": { "type": "integer", "minimum": 0 },
        "unassigned_count": { "type": "integer", "minimum": 0 },
        "used_technicians": { "type": "integer", "minimum": 0 },
        "distance_km": { "type": "number", "minimum": 0 },
        "travel_minutes": { "type": "integer", "minimum": 0 },
        "service_minutes": { "type": "integer", "minimum": 0 },
        "wait_minutes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
